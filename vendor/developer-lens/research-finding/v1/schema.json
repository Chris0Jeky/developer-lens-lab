      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "reject",
            "revise_once",
            "benchmarked"
          ],
          "type": "string"
        },
        "retained_fallback": {
          "anyOf": [
            {
              "enum": [
                "rolling_median_mad",
                "bocpd_gaussian",
                "pelt_offline"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "retained_fallback",
        "summary"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
