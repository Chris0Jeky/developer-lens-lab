              "label": {
                "const": "Baseline selection is viable",
                "type": "string"
              },
              "passed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "code",
              "label",
              "passed"
